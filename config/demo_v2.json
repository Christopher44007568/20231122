{
  "format": 2,
  "render": {
    "width": 320,
    "height": 240,
    "headless": true,
    "validation": true,
    "clear_color": [0.02, 0.02, 0.05, 1.0],
    "line_color": [0.15, 0.85, 0.35, 1.0]
  },
  "grid": {
    "columns": 10,
    "rows": 8
  },
  "run": {
    "frames": 6,
    "output_dir": "artifacts/runs"
  },
  "cancel": {
    "enabled": true,
    "after_frame": 3
  }
}
