# Embeds a SPIR-V blob as a C++17 byte array header.
file(READ "${SPV}" SPV_BYTES HEX)
string(LENGTH "${SPV_BYTES}" HEX_LEN)
math(EXPR BYTE_COUNT "${HEX_LEN} / 2")

set(OUT "// Auto-generated. Do not edit.\n")
string(APPEND OUT "#pragma once\n#include <cstddef>\n#include <cstdint>\n\n")
string(APPEND OUT "inline const std::uint32_t kVerifySpvSize = ${BYTE_COUNT};\n")
string(APPEND OUT "inline const unsigned char kVerifySpv[] = {\n")

set(I 0)
set(LINE "")
while(I LESS HEX_LEN)
  string(SUBSTRING "${SPV_BYTES}" ${I} 2 HEX_PAIR)
  string(APPEND LINE "0x${HEX_PAIR},")
  math(EXPR I "${I} + 2")
  math(EXPR COL "${I} / 2")
  math(EXPR REM "${COL} % 16")
  if(REM EQUAL 0)
    string(APPEND OUT "${LINE}\n")
    set(LINE "")
  endif()
endwhile()
if(NOT LINE STREQUAL "")
  string(APPEND OUT "${LINE}\n")
endif()
string(APPEND OUT "};\n")
file(WRITE "${HEADER}" "${OUT}")
