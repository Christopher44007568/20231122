#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) writeonly buffer OutputPixels {
    uint pixels[];
} output_buffer;

layout(push_constant) uniform Parameters {
    uint width;
    uint height;
    uint tileY;
    uint tileHeight;
    uint frameIndex;
    uint totalFrames;
    uint deviceIndex;
    uint seed;
    float timeSeconds;
    float focusDepth;
    float aperture;
    float phase;
    float clockOffsetMs;
    float clockDriftPpm;
    float exposure;
    float padding;
} params;

const float PI = 3.14159265358979323846;
const float TAU = 6.28318530717958647692;

float saturate(float value) {
    return clamp(value, 0.0, 1.0);
}

float fractf(float value) {
    return value - floor(value);
}

vec3 mix3(vec3 a, vec3 b, float t) {
    return mix(a, b, t);
}

float hash21(float x, float y) {
    float value = sin(x * 127.1 + y * 311.7) * 43758.5453123;
    return fract(value);
}

vec3 hueColor(float hue) {
    vec3 color = vec3(
        abs(hue * 6.0 - 3.0) - 1.0,
        abs(mod(hue * 6.0 + 2.0, 6.0) - 3.0) - 1.0,
        abs(mod(hue * 6.0 + 4.0, 6.0) - 3.0) - 1.0);
    return clamp(color, 0.0, 1.0);
}

float polygonRadius(float x, float y, float radius, float blades) {
    float angle = atan(y, x);
    float sector = TAU / blades;
    float local = mod(angle + sector * 0.5, sector) - sector * 0.5;
    return radius * cos(PI / blades) / cos(local);
}

vec3 background(float u, float v) {
    vec3 low = vec3(0.006, 0.011, 0.027);
    vec3 high = vec3(0.042, 0.024, 0.072);
    vec3 color = mix3(low, high, v);
    float aspect = float(params.width) / float(params.height);
    float radial = sqrt((u - 0.5) * (u - 0.5) * aspect * aspect + (v - 0.5) * (v - 0.5));
    float vignette = saturate(1.0 - radial * 0.72);
    color *= 0.72 + 0.36 * vignette;

    float cellX = floor(u * 37.0);
    float cellY = floor(v * 23.0);
    if (hash21(cellX + 0.5, cellY + 0.5) > 0.955) {
        float sx = (cellX + 0.5) / 37.0;
        float sy = (cellY + 0.5) / 23.0;
        float distanceToStar = sqrt((u - sx) * (u - sx) + (v - sy) * (v - sy));
        float sparkle = saturate(1.0 - distanceToStar * 900.0) * 0.28;
        color += vec3(sparkle * 0.72, sparkle * 0.86, sparkle);
    }
    return color;
}

vec3 shade(float pixelX, float pixelY) {
    float width = float(params.width);
    float height = float(params.height);
    float u = (pixelX + 0.5) / width;
    float v = (pixelY + 0.5) / height;
    float aspect = width / height;
    vec3 color = background(u, v);
    float time = params.timeSeconds;

    for (int index = 0; index < 9; ++index) {
        float fi = float(index);
        float depth = index == 0
            ? params.focusDepth
            : 0.17 + 0.79 * fractf(fi * 0.6180339 + 0.09);
        float direction = mod(fi, 2.0) == 0.0 ? 1.0 : -1.0;
        float orbit = TAU * fractf(fi * 0.381966 + 0.13) +
                      time * (0.055 + 0.018 * depth) * direction;
        float drift = 0.012 * sin(time * 0.37 + fi * 1.7);
        float centerX = 0.5 + cos(orbit) * (0.17 + 0.13 * depth) + drift;
        float centerY = 0.5 + sin(orbit) * (0.14 + 0.16 * depth) +
                        0.010 * cos(time * 0.29 + fi);
        if (index == 0) {
            centerX = 0.5 + 0.025 * sin(time * 0.31);
            centerY = 0.5 + 0.018 * cos(time * 0.43);
        }

        float coc = params.aperture * abs(depth - params.focusDepth);
        float pulse = 0.92 + 0.08 * sin(time * 1.15 + fi * 0.61);
        float radius = index == 0 ? 0.078 * pulse : (0.014 + coc * 0.56) * pulse;
        radius *= 0.88 + 0.12 * sin(fi * 2.31 + time * 0.2);
        float rotation = time * 0.09 + fi * 0.41 + float(params.deviceIndex) * 0.017;
        float qx = (u - centerX) * aspect;
        float qy = v - centerY;
        float cosR = cos(rotation);
        float sinR = sin(rotation);
        float localX = qx * cosR - qy * sinR;
        float localY = qx * sinR + qy * cosR;
        float boundary = polygonRadius(localX, localY, radius, 6.0);
        float distanceToShape = sqrt(localX * localX + localY * localY) - boundary;
        float aa = 1.35 / height;
        float body = 1.0 - smoothstep(-aa, aa, distanceToShape);
        if (body <= 0.0) {
            continue;
        }

        float edgeBand = radius * 0.115;
        float edgeDistance = (distanceToShape + edgeBand * 0.82) / edgeBand;
        float edge = exp(-edgeDistance * edgeDistance) * body;
        float radial = sqrt(localX * localX + localY * localY) / max(boundary, 0.0001);
        float core = pow(saturate(1.0 - radial), 3.0);
        float alpha = saturate(0.115 * body + 0.50 * edge + 0.055 * core);

        float hue = 0.53 + depth * 0.31 + fi * 0.013 + float(params.deviceIndex) * 0.018;
        vec3 tint = hueColor(fractf(hue));
        tint = tint * 0.72 + vec3(0.24, 0.20, 0.18);
        float luminance = 0.38 + 1.05 * depth + 1.35 * edge;
        if (index == 0) {
            luminance += 0.60;
        }
        tint *= luminance * params.exposure;
        color = mix3(color, tint, alpha);
    }

    float grain = hash21(pixelX + float(params.seed % 65536u),
                         pixelY + float(params.frameIndex * 17u));
    color += vec3((grain - 0.5) * 0.012);
    return color;
}

void main() {
    uvec2 global = gl_GlobalInvocationID.xy;
    if (global.x >= params.width || global.y >= params.tileHeight) {
        return;
    }
    float pixelX = float(global.x);
    float pixelY = float(params.tileY + global.y);
    vec3 linear = shade(pixelX, pixelY);
    vec3 mapped = linear / (1.0 + max(linear, vec3(0.0)));
    vec3 gamma = pow(clamp(mapped, 0.0, 1.0), vec3(1.0 / 2.2));
    uvec3 bytes = uvec3(round(gamma * 255.0));
    uint packed = bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (255u << 24u);
    output_buffer.pixels[global.y * params.width + global.x] = packed;
}

